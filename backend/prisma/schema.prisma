generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  username              String                 @unique
  password              String
  people                Person[]
  orders                Order[]
  inventory             Inventory[]
  stockMovements        StockMovement[]
  saleCounter           SaleCounter?
  financialCategories   FinancialCategory[]
  financialTransactions FinancialTransaction[]
  creditCardBills       CreditCardBill[]
  rides                 RideRecord[]
  apiTokens             ApiToken[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

// Scoped API token for trusted first-party integrations (the Chrome extension).
// Only the SHA-256 hash is stored, so a database leak never reveals usable
// tokens; the cleartext is returned exactly once, by the create endpoint.
model ApiToken {
  id        String    @id @default(uuid())
  userId    String
  name      String    @db.VarChar(60)
  // Purpose of the token, e.g. "uber:import". The uber import route checks it.
  scope     String    @default("uber:import") @db.VarChar(40)
  tokenHash String    @unique
  // Last four cleartext characters, so the UI can show which token is which.
  lastFour  String    @db.Char(4)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Person {
  id              String    @id @default(uuid())
  name            String
  whatsapp        String?
  commonGroups    String?   @db.VarChar(255)
  instagram       String?   @db.VarChar(255)
  address         String?   @db.VarChar(500)
  observacao      String?   @db.VarChar(2000)
  birthday        String?   @db.VarChar(5)
  isVip           Boolean   @default(false)
  isDoterraMember Boolean   @default(false)
  isTeamMember    Boolean   @default(false)
  isSelf          Boolean   @default(false)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  items           Item[]
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Order {
  id                             String                 @id @default(uuid())
  orderNumber                    String
  totalValue                     Decimal                @db.Decimal(10, 2)
  shippingValue                  Decimal                @default(0) @db.Decimal(10, 2)
  additionalValue                Decimal                @default(0) @db.Decimal(10, 2)
  // Sales only: whether "Valores Adicionais" are charged to the client. When
  // false the seller absorbs the cost, so it does not count toward totalValue,
  // pending balance or QUITADO, even though it still generates a ledger expense.
  additionalValueChargedToClient Boolean                @default(true)
  orderDate                      DateTime               @default(now())
  status                         OrderStatus            @default(PENDENTE)
  orderType                      OrderType              @default(COMPRA)
  isTeamOrder                    Boolean                @default(false)
  deliveredAt                    DateTime?
  accountOwner                   String?                @db.VarChar(120)
  paymentType                    PaymentType?
  // Sales only: the seller passes the payment-gateway fee (e.g. InfinitePay)
  // on to the client, so the amount charged is higher than the sale total.
  passesGatewayFeeToClient       Boolean                @default(false)
  orderNotes                     String?                @db.VarChar(2000)
  // Set by the dōTERRA orders import: the order was created from captured
  // evidence and still needs the user's review. Cleared when the user saves
  // the order or uses the "mark reviewed" quick action. Manual orders are
  // always false.
  pendingReview                  Boolean                @default(false)
  doterraPv                      Decimal?               @db.Decimal(10, 2)
  doterraValue                   Decimal?               @db.Decimal(10, 2)
  attachmentFilename             String?                @db.VarChar(255)
  installments                   Int?
  firstInstallmentAt             DateTime?              @db.Date
  user                           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                         String
  items                          Item[]
  payments                       Payment[]
  stockMovements                 StockMovement[]
  financialTransactions          FinancialTransaction[]
  creditCardBill                 CreditCardBill?
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt

  @@unique([orderNumber, userId])
}

enum OrderType {
  COMPRA
  VENDA
}

// Per-user sequence used to generate human-friendly sale order numbers (V-0001,
// V-0002, ...). Incremented atomically inside the create-sale transaction.
model SaleCounter {
  userId     String   @id
  lastNumber Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum OrderStatus {
  PENDENTE
  PARCIAL
  QUITADO
  EQUIPE
}

enum PaymentType {
  PIX
  BOLETO
  CARTAO_CREDITO
  INFINITE_PAY
  DINHEIRO
}

model Item {
  id               String           @id @default(uuid())
  description      String?
  chargedValue     Decimal          @db.Decimal(10, 2)
  memberPrice      Decimal?         @db.Decimal(10, 2)
  details          String?          @db.VarChar(500)
  product          Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId        String?
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  person           Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId         String?
  quantity         Int              @default(1)
  forStock         Boolean          @default(false)
  useCashback      Boolean          @default(false)
  chargedValueMode ChargedValueMode @default(UNIT)
  kitStockMode     KitStockMode?
  kitSnapshot      Json?
  stockMovements   StockMovement[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([productId])
}

enum ChargedValueMode {
  UNIT
  TOTAL
}

// How a stock-bound kit item affects inventory:
// - KIT: the kit product itself is stocked as a single unit.
// - COMPONENTS: each component of the kit is stocked (componentQty × itemQty).
enum KitStockMode {
  KIT
  COMPONENTS
}

model Payment {
  id                    String                 @id @default(uuid())
  amount                Decimal                @db.Decimal(10, 2)
  // Net amount the user actually received after the gateway fee. NULL means no
  // fee (or not informed), so the net equals `amount`. The fee is always
  // derived (`amount - netAmount`) and never persisted.
  netAmount             Decimal?               @db.Decimal(10, 2)
  paidAt                DateTime               @default(now())
  paymentType           PaymentType?
  notes                 String?
  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId               String
  person                Person?                @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId              String?
  financialTransactions FinancialTransaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Product {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  size        String
  status      ProductStatus @default(ATIVO)
  productType ProductType   @default(SIMPLES)
  doterraUrl  String?       @db.VarChar(2048)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  prices          ProductPrice[]
  items           Item[]
  inventory       Inventory[]
  stockMovements  StockMovement[]
  kitComponents   KitComposition[] @relation("KitComponents") // composition when this product is a KIT
  componentOfKits KitComposition[] @relation("ComponentOfKits") // kits that use this product as a component

  @@index([status])
}

enum ProductStatus {
  ATIVO
  INDISPONIVEL
  INATIVO
  // Draft product auto-registered by the dōTERRA orders import for a code that
  // was missing from the catalog. The user completes its prices and activates
  // it; drafts are never offered in order/sale forms and can be hard-deleted
  // with the imported order that created them.
  PENDENTE_CADASTRO
}

enum ProductType {
  SIMPLES
  KIT
}

// Live composition of a KIT product. A kit is composed of one or more SIMPLES
// products, each with its own quantity inside the kit. Order items snapshot the
// composition at creation time (Item.kitSnapshot) so later edits to this table
// never affect stock control of already-registered orders.
model KitComposition {
  id                 String @id @default(uuid())
  kitProductId       String
  componentProductId String
  quantity           Int    @default(1)

  kitProduct       Product @relation("KitComponents", fields: [kitProductId], references: [id], onDelete: Cascade)
  componentProduct Product @relation("ComponentOfKits", fields: [componentProductId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([kitProductId, componentProductId])
  @@index([componentProductId])
}

model ProductPrice {
  id           String    @id @default(uuid())
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  regularPrice Decimal   @db.Decimal(10, 2)
  memberPrice  Decimal   @db.Decimal(10, 2)
  pv           Decimal   @db.Decimal(10, 2)
  validFrom    DateTime  @default(now())
  validTo      DateTime?
  createdAt    DateTime  @default(now())

  @@index([productId, validFrom])
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

model Inventory {
  id        String @id @default(uuid())
  userId    String
  productId String
  quantity  Int    @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

model StockMovement {
  id            String            @id @default(uuid())
  userId        String
  productId     String
  quantity      Int
  type          StockMovementType
  reason        String?
  orderId       String?
  itemId        String?
  effectiveDate DateTime          @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  item    Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([itemId])
  @@index([userId, effectiveDate])
}

enum FinancialTransactionType {
  RECEITA
  DESPESA
}

enum FinancialOrigin {
  VENDA
  RESGATE_INFINITEPAY
  PEDIDO_DOTERRA
  VENDA_ADICIONAL
  MANUAL
  CARTAO_CREDITO
  UBER
}

model FinancialCategory {
  id           String                   @id @default(uuid())
  userId       String
  name         String
  type         FinancialTransactionType
  isDefault    Boolean                  @default(false)
  active       Boolean                  @default(true)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]
  creditCardBills CreditCardBill[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([userId, type, name])
  @@index([userId])
}

model CreditCardBill {
  id                 String       @id @default(uuid())
  userId             String
  description        String       @db.VarChar(255)
  totalCents         Int
  installments       Int
  firstInstallmentAt DateTime     @db.Date
  brand              String?      @db.VarChar(40)
  notes              String?      @db.VarChar(2000)
  categoryId         String?
  orderId            String?      @unique
  paymentType        PaymentType  @default(CARTAO_CREDITO)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category           FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  order              Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  transactions       FinancialTransaction[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([userId])
  @@index([userId, firstInstallmentAt])
}

model FinancialTransaction {
  id                String                   @id @default(uuid())
  userId            String
  type              FinancialTransactionType
  origin            FinancialOrigin
  amount            Decimal                  @db.Decimal(10, 2)
  description       String                   @db.VarChar(255)
  transactionDate   DateTime                 @db.Date
  notes             String?                  @db.VarChar(2000)
  isEffective       Boolean                  @default(true)
  effectiveDate     DateTime?                @db.Date
  installmentNumber Int?
  installmentsTotal Int?
  paymentType       PaymentType?
  statementFitid    String?                  @db.VarChar(64)
  categoryId        String?
  orderId           String?
  paymentId         String?
  creditCardBillId  String?
  rideId            String?                  @unique
  importBatchId     String?
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          FinancialCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  order             Order?                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment           Payment?                 @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  creditCardBill    CreditCardBill?          @relation(fields: [creditCardBillId], references: [id], onDelete: Cascade)
  ride              RideRecord?              @relation(fields: [rideId], references: [id], onDelete: SetNull)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([paymentId])
  @@index([userId, transactionDate])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@index([userId, isEffective])
  @@index([orderId])
  @@index([userId, importBatchId])
}

// A single Uber ride captured from the rider activity feed. `externalId` is the
// ride UUID (stable across imports), which makes re-importing the same JSON
// idempotent. The ride is linked to at most one ledger entry through
// `FinancialTransaction.rideId`, so the same ride can never generate two
// expenses.
enum RideSource {
  UBER_ACTIVITY_JSON
  UBER_SESSION
  UBER_EMAIL
  UBER_BUSINESS
  MANUAL
}

enum RideStatus {
  COMPLETED
  CANCELLED
}

// Delivery (courier/motorcycle) vs passenger ride. `UNKNOWN` covers the
// featured activity, whose `imageURL` is a route map without a vehicle asset.
enum RideType {
  RIDE
  DELIVERY
  UNKNOWN
}

model RideRecord {
  id            String     @id @default(uuid())
  userId        String
  source        RideSource
  externalId    String     @db.VarChar(64)
  profileType   String?    @db.VarChar(20)
  riderName     String?    @db.VarChar(120)
  requestedAt   DateTime
  destination   String?    @db.VarChar(255)
  amountCents   Int
  currency      String     @default("BRL") @db.VarChar(3)
  status        RideStatus @default(COMPLETED)
  rideType      RideType   @default(UNKNOWN)
  importBatchId String?
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   FinancialTransaction?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([userId, source, externalId])
  @@index([userId, requestedAt])
  @@index([userId, status])
  @@index([userId, importBatchId])
}
