generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  username       String          @unique
  password       String
  people         Person[]
  orders         Order[]
  inventory      Inventory[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Person {
  id              String    @id @default(uuid())
  name            String
  whatsapp        String?
  commonGroups    String?   @db.VarChar(255)
  instagram       String?   @db.VarChar(255)
  address         String?   @db.VarChar(500)
  observacao      String?   @db.VarChar(2000)
  isVip           Boolean   @default(false)
  isDoterraMember Boolean   @default(false)
  isSelf          Boolean   @default(false)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  items           Item[]
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Order {
  id           String       @id @default(uuid())
  orderNumber  String
  totalValue   Decimal      @db.Decimal(10, 2)
  shippingValue Decimal     @db.Decimal(10, 2) @default(0)
  orderDate    DateTime     @default(now())
  status       OrderStatus  @default(PENDENTE)
  accountOwner String?      @db.VarChar(120)
  paymentType  PaymentType?
  orderNotes   String?      @db.VarChar(500)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  items        Item[]
  payments     Payment[]
  stockMovements StockMovement[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([orderNumber, userId])
}

enum OrderStatus {
  PENDENTE
  PARCIAL
  QUITADO
}

enum PaymentType {
  PIX
  BOLETO
  CARTAO_CREDITO
}

model Item {
  id           String   @id @default(uuid())
  description  String?
  chargedValue Decimal  @db.Decimal(10, 2)
  memberPrice  Decimal? @db.Decimal(10, 2)
  pv           Decimal? @db.Decimal(10, 2)
  details      String?  @db.VarChar(500)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId    String?
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  person       Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId     String?
  quantity          Int               @default(1)
  forStock          Boolean           @default(false)
  chargedValueMode  ChargedValueMode  @default(UNIT)
  kitStockMode      KitStockMode?
  kitSnapshot       Json?
  stockMovements    StockMovement[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
}

enum ChargedValueMode {
  UNIT
  TOTAL
}

// How a stock-bound kit item affects inventory:
// - KIT: the kit product itself is stocked as a single unit.
// - COMPONENTS: each component of the kit is stocked (componentQty × itemQty).
enum KitStockMode {
  KIT
  COMPONENTS
}

model Payment {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(10, 2)
  paidAt    DateTime @default(now())
  notes     String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  size        String
  status      ProductStatus @default(ATIVO)
  productType ProductType   @default(SIMPLES)
  doterraUrl  String?       @db.VarChar(2048)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  prices           ProductPrice[]
  items            Item[]
  inventory        Inventory[]
  stockMovements   StockMovement[]
  kitComponents    KitComposition[] @relation("KitComponents") // composition when this product is a KIT
  componentOfKits  KitComposition[] @relation("ComponentOfKits") // kits that use this product as a component

  @@index([status])
}

enum ProductStatus {
  ATIVO
  INDISPONIVEL
  INATIVO
}

enum ProductType {
  SIMPLES
  KIT
}

// Live composition of a KIT product. A kit is composed of one or more SIMPLES
// products, each with its own quantity inside the kit. Order items snapshot the
// composition at creation time (Item.kitSnapshot) so later edits to this table
// never affect stock control of already-registered orders.
model KitComposition {
  id                 String  @id @default(uuid())
  kitProductId       String
  componentProductId String
  quantity           Int     @default(1)

  kitProduct       Product @relation("KitComponents", fields: [kitProductId], references: [id], onDelete: Cascade)
  componentProduct Product @relation("ComponentOfKits", fields: [componentProductId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([kitProductId, componentProductId])
  @@index([componentProductId])
}

model ProductPrice {
  id           String    @id @default(uuid())
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  regularPrice Decimal   @db.Decimal(10, 2)
  memberPrice  Decimal   @db.Decimal(10, 2)
  pv           Decimal   @db.Decimal(10, 2)
  validFrom    DateTime  @default(now())
  validTo      DateTime?
  createdAt    DateTime  @default(now())

  @@index([productId, validFrom])
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

model Inventory {
  id        String @id @default(uuid())
  userId    String
  productId String
  quantity  Int    @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

model StockMovement {
  id            String            @id @default(uuid())
  userId        String
  productId     String
  quantity      Int
  type          StockMovementType
  reason        String?
  orderId       String?
  itemId        String?
  effectiveDate DateTime          @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  item    Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([itemId])
  @@index([userId, effectiveDate])
}
